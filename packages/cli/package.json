{
	"name": "@abimongo/cli",
	"version": "1.0.0",
	"publishConfig": {
		"registry": "http://localhost:4873/",
		"access": "public"
	},
	"main": "dist/bin/abimongo_cli.js",
	"types": "dist/bin/abimongo_cli.d.ts",
	"bin": {
		"abimongo-cli": "./dist/bin/abimongo_cli.js"
	},
  "exports": {
      ".": {
      "import": "./dist/bin/abimongo_cli.js",
      "require": "./dist/bin/abimongo_cli.js",
      "types": "./dist/bin/abimongo_cli.d.ts"
    }
  },
	"files": [
		"dist",
		"bin",
		"README.md",
		"LICENSE"
	],
	"type": "commonjs",
	"scripts": {
		"build:prod": "webpack --config webpack.config.js",
		"build": "pnpm run build:prod",
		"lint": "eslint src",
		"prepack": "pnpm build",
		"publish": " pnpm --recursive publish --no-git-checks"
	},
	"dependencies": {
		"@abimongo/core": "workspace:^1.0.0",
		"@abimongo/create": "workspace:^1.0.0",
		"@abimongo/logger": "workspace:^1.0.0",
		"commander": "^14.0.2"
	},
	"engines": {
		"node": ">=20.11.0",
		"pnpm": "10.19.0"
	},
	"license": "ISC",
	"description": "CLI tooling for Abimongo (shim + scaffold command).",
	"devDependencies": {
		"ts-loader": "^9.5.4",
		"tslib": "^2.8.1",
		"webpack": "^5.102.1",
		"webpack-cli": "^6.0.1"
	}
}