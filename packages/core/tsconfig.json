{
  "extends": "../../tsconfig.base.json", // Inherit common settings
  "compilerOptions": {                                                                                   
    "rootDir": "./src",
    "outDir": "./dist",                                                                                                                                                                     
    "composite": true,
    "declaration": true,  
    "resolveJsonModule": true,                           
  },
  "include": [
    "src",
    "src/**/*.json",
    "package.json"
  ],
  "references": [
    { "path": "../logger" }, // Reference to other local packages
  ],
  "exclude": [
    "./node_modules",
    "./examples",
    "**/__tests__/**"
  ],
}
