{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Abimongo Core Configuration Schema",
  "type": "object",
  "properties": {
    "projectName": {
      "type": "string",
      "description": "The name of the user's project."
    },
    "provider": {
      "type": "string",
      "description": "The database provider to use. Currently only 'mongodb' is supported.",
      "enum": ["mongodb"]
    },
    "mongoClient": {
      "type": "object",
      "description": "An instance of AbimongoClient to use for database connections. If provided, this will override the 'mongoUri' option.",
      "properties": {
        "connection": {
          "type": "object",
          "description": "The MongoDB connection object returned by AbimongoClient.init()."
        }
      },
      "required": ["connection"]
    },
    "connection": {
      "type": "object",
      "description": "MongoDB connection configuration. If 'mongoClient' is not provided, this will be used to create an AbimongoClient instance.",
      "properties": {
        "uri": {
          "type": "string",
          "description": "MongoDB connection URI."
        },
        "options": {
          "type": "object",
          "description": "Additional options for MongoDB connection."
        }
      },
      "required": ["uri"]
    },
    "abimongoClient": {
      "type": "object",
      "description": "Configuration for the AbimongoClient instance.",
      "properties": {
        "lazy": {
          "type": "boolean",
          "default": false,
          "description": "If true, AbimongoClient will not connect to MongoDB until the first request."
        },
        "config": {
          "type": "object",
          "description": "Additional configuration options for AbimongoClient."
        },
        "retryAttempts": {
          "type": "integer",
          "default": 3,
          "description": "Number of retry attempts for MongoDB connection."
        }
      }
    },
    "model": {
      "type": "object",
      "description": "Function to determine the model to use for a request. Returns the model name based on the request path.",
      "properties": {
        "defaultModel": {
          "type": "string",
          "default": "defaultModel"
        },
        "modelMap": {
          "type": "object",
          "description": "Mapping of request paths to model names.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "schema": {
      "type": "object",
      "description": "Function to determine the schema to use for a request. Returns the schema name based on the request path.",
      "properties": {
        "defaultSchema": {
          "type": "string",
          "default": "defaultSchema"
        },
        "schemaMap": {
          "type": "object",
          "description": "Mapping of request paths to schema names.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "multiTenant": {
      "type": "object",
      "description": "Function to determine if multi-tenant mode is enabled. Returns true if the request contains a tenant ID in the specified header.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "headerKey": {
          "type": "string",
          "default": "x-tenant-id"
        },
        "tenants": {
          "type": "object",
          "description": "Mapping of tenant IDs to their MongoDB URIs.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "initOptions": {
          "type": "object",
          "properties": {
            "lazy": {
              "type": "boolean",
              "default": false,
              "description": "If true, AbimongoClient will not connect to MongoDB until the first request."
            },
            "config": {},
            "retryAttempts": {
              "type": "integer",
              "default": 3,
              "description": "Number of retry attempts for MongoDB connection."
            }
          }
        }
      }
    },
    "logger": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error",
            "fatal",
            "trace"
          ]
        },
        "colorize": {
          "type": "boolean"
        },
        "json": {
          "type": "boolean"
        },
        "transports": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "console",
                  "file",
                  "http"
                ]
              },
              "options": {
                "type": "object"
              }
            }
          }
        },
        "formatOptions": {
          "type": "object"
        },
        "excludedSources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "circuitBreaker": {
          "enabled": true,
          "retryAttempts": 5
        },
        "enableMetrics": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false
                },
                "logInterval": {
                  "type": "integer",
                  "default": 60000
                }
              },
              "additionalProperties": false
            }
          ],
          "default": false
        },
        "compressLogFiles": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false
                }
              },
              "additionalProperties": false
            }
          ],
          "default": false
        }
      }
    },
    "graphql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "subscriptions": {
          "type": "boolean",
          "default": false
        },
        "playground": {
          "type": "boolean",
          "default": true
        },
        "schemaOutputPath": {
          "type": "string",
          "default": "./src/graphql/schema.gql"
        }
      }
    },
    "features": {
      "type": "object",
      "properties": {
        "models": {
          "type": "string",
          "default": "./src/models"
        },
        "schemas": {
          "type": "string",
          "default": "./src/schemas"
        },
        "useRedisCache": {
          "type": "boolean",
          "default": false
        },
        "redisUri": {
          "type": "string",
          "default": ""
        }
      }
    },
    "advanced": {
      "type": "object",
      "description": "Advanced configuration options for Abimongo.",
      "properties": {
        "circuitBreaker": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "If true, enables the circuit breaker pattern to prevent cascading failures."
            },
            "retryAttempts": {
              "type": "integer",
              "default": 5,
              "description": "Number of retry attempts before the circuit breaker opens."
            }
          }
        },
        "garbageCollector": {
          "type": "object",
          "description": "Configuration for the garbage collector that cleans up old data.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "retentionPeriod": {
              "type": "integer",
              "default": 30,
              "description": "Number of days to retain garbage collected data."
            },
            "logResults": {
              "type": "boolean",
              "default": true,
              "description": "If true, logs the results of garbage collection."
            }
          }
        },
        "compressLogFiles": {
          "type": "boolean",
          "default": false
        },
        "gcCron": {
          "type": "string",
          "default": "*/10 * * * * *"
        }
      }
    },
    "abimongoCoreVersion": {
      "type": "string",
      "default": "1.0.0",
      "description": "Version of the Abimongo Core library."
    }
  },
  "required": [
    "mongoUri"
  ]
}