{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
  "rootDir": ".",
  "outDir": "dist",
  "ignoreDeprecations": "6.0",
   "composite": true
  },
  "include": [
    "index.ts",
    "src",
    "./*", 
    "browser.ts", 
    "bin/abimongo-core-cli.ts",
    "setupTest.ts"
  ],  
  "exclude": [
    "./node_modules",
    "./examples",
    "**/__tests__/**"
  ]
}


