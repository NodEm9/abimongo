{
  "name": "abimongo",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm run build:ordered",
    "build:ordered": "pnpm --filter @abimongo/logger build && pnpm --filter @abimongo/core build && pnpm --filter @abimongo/cli build && pnpm --filter @abimongo/create build",
    "test": "pnpm --recursive test",
    "test-wcwidth": "node scripts/test-wcwidth.js",
    "test-splash": "node scripts/test-splash.js",
    "postinstall": "node scripts/postinstall-splash.js",
    "lint": "pnpm -w exec eslint \"packages/**/src/**/*.{ts,tsx,js,jsx}\"",
    "lint:fix": "pnpm -w exec eslint \"packages/**/src/**/*.{ts,tsx,js,jsx}\" --fix",
    "build:logger": "pnpm --filter @abimongo/logger build",
    "build:core": "pnpm --filter @abimongo/core build",
    "build:create": "pnpm --filter @abimongo/create build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "changelog:generate": "changeset version",
    "docs:changelog": "node ./scripts/copy-changelog.js",
    "docs:prepare-changelog": "pnpm changelog:generate && pnpm docs:changelog",
    "docs:dev": "docusaurus start docs/website",
    "docs:dev:all": "node docs/website/dev/run-dev.js",
    "docs:proxy": "node docs/website/dev/dev-proxy.js",
    "docs:api": "pnpm --recursive run typedoc",
    "docs:sanitize": "node ./scripts/sanitize-typedoc-md.js",
    "api:docs": "pnpm docs:api && pnpm run docs:sanitize",
    "dev:css": "tailwindcss -i docs/website/src/css/tw-input.css -o docs/website/src/css/custom.css --watch",
    "build:css": "tailwindcss -i docs/website/src/css/tw-input.css -o docs/website/src/css/custom.css --minify",
    "docs:build": "pnpm run build:css && docusaurus build docs/website",
    "docs:serve": "docusaurus serve docs/website/build",
    "docs:clean": "rimraf docs/website/build",
    "dev:metrics-server": "node docs/website/dev/metrics-server.js",
    "typecheck": "pnpm -w -r exec tsc --build",
    "publish": "pnpm -r publish --access public --tag latest --no-git-checks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NodEm9/abimongo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/NodEm9/abimongo/issues"
  },
  "homepage": "https://github.com/NodEm9/abimongo#readme",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10.20.0"
  },
  "devDependencies": {
    "@abimongo/core": "workspace:*",
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/preset-classic": "^3.9.2",
    "@docusaurus/types": "^3.9.2",
    "@eslint/js": "^9.39.0",
    "@tailwindcss/cli": "^4.1.17",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.8.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "autoprefixer": "^10.4.22",
    "docusaurus": "^0.0.2",
    "docusaurus-plugin-typedoc": "^1.4.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "figlet": "^1.9.4",
    "gh-pages": "^6.3.0",
    "highlight.js": "^11.11.1",
    "jimp": "^1.6.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.17",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.3",
    "typescript-cached-transpile": "^0.0.6",
    "typescript-eslint": "8.30.1"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "fs-extra": "^11.3.2",
    "minimist": "^1.2.8",
    "prism-react-renderer": "^2.4.1",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6"
  },
  "pnpm": {
    "overrides": {
      "graphql": "16.11.0"
    }
  }
}