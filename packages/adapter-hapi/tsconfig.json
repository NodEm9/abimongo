{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "module": "ES2020",
    "target": "ES2020",
    "moduleResolution": "Bundler",
    "composite": true,
    "skipLibCheck": true
  },
    "include": ["src/**/*.ts"],
}
