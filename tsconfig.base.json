{
  "compilerOptions": {
    "target": "ES2021",
    "lib": [
      "ES2021", 
      "ES2022.Error",
      "ES2022.Object",
      "esnext.disposable",
      "DOM.Iterable", 
      "DOM"
      ],  
    "moduleDetection": "auto",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    // "paths": {
    //   "@abimongo/logger": ["./packages/logger/src/index.ts"],
    //   "@abimongo/core":   ["./packages/core/src/index.ts"],
    //   "@abimongo/create": ["./packages/create/src/index.ts"]
    // },
    "declarationMap": true,
    "esModuleInterop": true,
    "isolatedModules": true, 
    "experimentalDecorators": true,
    "importHelpers": true,
    "forceConsistentCasingInFileNames": true,
    // "noEmitOnError": false,
    "resolvePackageJsonExports": true,
    "resolveJsonModule": true, 
    "inlineSourceMap": false,                                                                                                                                    
    "noImplicitAny": false,                            
    "strict": true,                                                                  
    "skipLibCheck": true, 
    "jsx": "react-jsx"                              
  },
  "ts-node": {
    "transpileOnly": true,
    "compiler": "typescript-cached-transpile"
  },
  "include": [
    "packages/*", 
    "docs/*", 
    ],
  "exclude": ["node_modules", "packages/core/examples", "packages/*/src/__test__/**"]
}
