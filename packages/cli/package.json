{
	"name": "@abimongo/cli",
	"version": "1.1.4",
	"publishConfig": {
		"access": "public"
	},
	"main": "dist/abimongo_cli.js",
	"types": "dist/abimongo_cli.d.ts",
	"bin": {
		"abimongo-cli": "./dist/abimongo_cli.js"
	},
	"exports": {
		".": {
			"import": "./dist/abimongo_cli.js",
			"require": "./dist/abimongo_cli.js",
			"types": "./dist/abimongo_cli.d.ts"
		}
	},
	"files": [
		"dist",
		"bin",
		"README.md",
		"LICENSE"
	],
	"type": "commonjs",
	"scripts": {
		"build:prod": "node ./scripts/run-webpack.js",
		"build": "pnpm run build:prod",
		"lint": "eslint src",
		"prepack": "pnpm build",
		"publish": " pnpm --recursive publish --no-git-checks",
		"postinstall": "node ../../scripts/postinstall-splash.js"
	},
	"release": {
		"branches": [
			"main"
		]
	},
	"dependencies": {
		"@abimongo/core": "workspace:*",
		"@abimongo/create": "workspace:*",
		"@abimongo/logger": "workspace:*",
		"commander": "^14.0.2"
	},
	"engines": {
		"node": ">=20.11.0",
		"pnpm": ">=10.20.0"
	},
	"license": "ISC",
	"description": "CLI tooling for Abimongo (shim + scaffold command).",
	"devDependencies": {
		"figlet": "^1.9.3",
		"ts-loader": "^9.5.4",
		"tslib": "^2.8.1",
		"webpack": "^5.102.1",
		"webpack-cli": "^6.0.1"
	}
}