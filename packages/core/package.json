{
  "name": "@abimongo/core",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Enterprise-grade MongoDB ORM built on the official MongoDB driver.",
  "main": "./dist/abimongo-core.js",
  "module": "./dist/abimongo-core.js",
  "browser": "./dist/abimongo-core-browser.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "abimongo": "./dist/abimongo-core-cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/abimongo-core.js",
      "require": "./dist/abimongo-core.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/abimongo-core-browser.js",
      "require": "./dist/abimongo-core-browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "!dist/scripts"
  ],
  "scripts": {
    "build:node": "webpack --config webpack.node.config.js",
    "build:cli": "webpack --config webpack.cli.config.js",
    "build:web": "webpack --config webpack.web.config.js",
    "clean": "rimraf dist",
    "build": "pnpm run build:node && pnpm run build:cli && pnpm run build:web",
    "lint": "eslint src",
    "clean:all": "rimraf dist && rimraf docs",
    "typedoc": "typedoc --options typedoc.json",
    "semantic-release": "semantic-release",
    "changeset": "pnpm run changeset",
    "release": "pnpm changeset version",
    "test": "jest --detectOpenHandles --coverage",
    "docusaurus:build": "cd website && pnpm docusaurus build",
    "docusaurus:start": "cd website && pnpm docusaurus start",
    "docusaurus:deploy": "cd website && pnpm docusaurus deploy",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm build",
    "publish": "pnpm --recursive publish --access public --tag latest --no-git-checks"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "keywords": [
    "mongodb",
    "odm",
    "core",
    "abimongo",
    "library"
  ],
  "author": "Emmanuel Nodolomwanyi",
  "maintainers": [
    {
      "name": "Emmanuel Nodolomwanyi"
    }
  ],
  "license": "ISC",
  "dependencies": {
    "@abimongo/logger": "workspace:*",
    "@babel/runtime": "^7.27.1",
    "commander": "^14.0.2",
    "docusaurus": "^0.0.2",
    "fs-extra": "^11.3.2",
    "node-cron": "4.2.0",
    "reflect-metadata": "0.2.2"
  },
  "peerDependencies": {
    "@apollo/server": "^5.0.0",
    "@graphql-tools/schema": "10.0.23",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "buffer": "6.0.3",
    "console-browserify": "^1.2.0",
    "dotenv": "^16.4.7",
    "graphql": "16.11.0",
    "graphql-http": "1.22.4",
    "graphql-redis-subscriptions": "2.7.0",
    "graphql-subscriptions": "3.0.0",
    "graphql-tag": "2.12.6",
    "graphql-ws": "5.16.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^5 || ^6",
    "redis": "4.7.1",
    "ws": "8.18.3"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": false
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/eslint-parser": "^7.27.0",
    "@babel/plugin-transform-modules-commonjs": "^7.26.3",
    "@babel/plugin-transform-runtime": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.27.0",
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/plugin-content-docs": "^3.9.2",
    "@docusaurus/preset-classic": "^3.9.2",
    "@eslint/js": "^9.23.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.3",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.30",
    "@types/webpack": "5.28.5",
    "globals": "^14.0.0",
    "axios": "^1.9.0",
    "babel-loader": "^10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "conventional-changelog-cli": "^4.1.0",
    "crypto-browserify": "^3.12.1",
    "eslint": "^9.23.0",
    "eslint-webpack-plugin": "^5.0.1",
    "express": "^5.1.0",
    "express-serve-static-core": "^0.1.1",
    "figlet": "^1.9.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "path-browserify": "^1.0.1",
    "semantic-release": "^24.2.5",
    "socket.io-client": "^4.8.1",
    "stream-browserify": "^3.0.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.1",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tslib": "^2.8.1",
    "tsx": "^4.20.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.30.1",
    "webpack": "5.98.0",
    "webpack-cli": "6.0.1",
    "webpack-node-externals": "^3.0.0",
    "webpack-remove-debug": "^0.1.0",
    "webpack-shebang-plugin": "^1.1.8"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10.20.0"
  }
}