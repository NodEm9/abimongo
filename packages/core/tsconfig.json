{
  "extends": "../../tsconfig.base.json", // Inherit common settings
  "compilerOptions": {                                                                                   
    "rootDir": "./",
    "outDir": "./dist",                                                                                                                                                                     
    "composite": true,
    "declaration": true,  
    "resolveJsonModule": true                             
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "./bin/abimongo-core-cli.ts",
    "browser.ts",
    "src/**/*.json"
  ],
  "references": [
    { "path": "../logger" }, // Reference to other local packages
  ],
  "exclude": [
    "./node_modules",
    "./examples",
    "**/__tests__/**"
  ],
}
