{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2022", "DOM.Iterable", "DOM"],  
    "moduleDetection": "auto",                                                                                     
    "module": "nodenext",                              
    "moduleResolution": "nodenext",  
    "rootDir": "./",
    "outDir": "./dist",                                                        
    "declaration": true, 
    "declarationDir": "./dist",
    "declarationMap": true, 
    "esModuleInterop": true, 
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,                                                                                          
    "sourceMap": true,                                                
    "noImplicitAny": false,                            
    "strict": true,                                                                  
    "skipLibCheck": true, 
    "jsx": "react-jsx"                              
  },
  "include": [
    "index.ts",
    "src/**/*",
    "browser.ts", 
    "./bin/abimongo-scaffold.ts",
    // "docs-site/**/*"
  ],
  "exclude": [
    "./node_modules",
    "./examples",
    "**/__tests__/**"
  ]
  
}