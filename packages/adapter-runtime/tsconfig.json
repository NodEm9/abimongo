{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",                                                                                                                                                                     
    "composite": true,
    "declaration": true,  
    // "declarationDir": "./dist/types",
    "resolveJsonModule": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo"        
  },
  "references": [
