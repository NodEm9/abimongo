{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
     "rootDir": "./src",
    "outDir": "./dist",                                                                                                                                                                     
    "composite": true,
    "declaration": true,  
    "declarationDir": "./dist/types",
    "resolveJsonModule": true,        
  },
  "references": [
    { "path": "../adapter-types" }, // Reference to other local packages
  ],
  "include": [
    "src",
    "src/**/*.json",
    "package.json"
  ],
  "exclude": [
    "dist",
    "./node_modules",
  ],
}
