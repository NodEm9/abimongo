{
  "name": "abimongo",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "packageManager": "npm@11.0.0",
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "packages/core/dist",
    "packages/logger/dist",
    "packages/cli/dist"
  ],
  "scripts": {
    "build": "npm run build -ws",
    "test": "npm run test -ws",
    "lint": "npm run lint -ws",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "changelog:generate": "changeset version",
    "docs:changelog": "node ./scripts/copy-changelog.js",
    "docs:prepare-changelog": "npm run changelog:generate && npm run docs:changelog",
    "docs:dev": "docusaurus start docs/website",
    "docs:build": "docusaurus build docs/website",
    "docs:serve": "docusaurus serve docs/website/build",
    "docs:clean": "rimraf docs/website/build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NodEm9/abimongo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/NodEm9/abimongo/issues"
  },
  "homepage": "https://github.com/NodEm9/abimongo#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=11.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/preset-classic": "^3.9.2",
    "@types/node": "^24.8.1",
    "docusaurus": "^1.14.7",
    "docusaurus-plugin-typedoc": "^1.4.2",
    "highlight.js": "^11.11.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.0.1",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript-cached-transpile": "^0.0.6"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "prism-react-renderer": "^2.4.1"
  }
}