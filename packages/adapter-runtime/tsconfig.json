{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    // "module": "nodenext",
    "target": "ES2020",
    // "moduleResolution": "nodenext",
    "composite": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
  },
    "references": [
    { "path": "../adapter-types" }, // Reference to other local packages
    { "path": "../core" }
   ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

