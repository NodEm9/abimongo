{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Abimongo Core Configuration Schema",
  "type": "object",
  "properties": {
    "projectName": {
      "type": "string",
      "description": "The name of the user's project."
    },
    "mongoUri": {
      "type": "string",
      "description": "Default MongoDB connection URI used by AbimongoClient."
    },
    "abimongoClient": {
      "type": "object",
      "description": "Configuration for the AbimongoClient instance.",
      "properties": {
        "lazy": {
          "type": "boolean",
          "default": false,
          "description": "If true, AbimongoClient will not connect to MongoDB until the first request."
        },
        "config": {
          "type": "object",
          "description": "Additional configuration options for AbimongoClient."
        },
        "retryAttempts": {
          "type": "integer",
          "default": 3,
          "description": "Number of retry attempts for MongoDB connection."
        }
      }
    },
    "model": {
      "type": "object",
      "description": "Function to determine the model to use for a request. Returns the model name based on the request path.",
      "properties": {
        "defaultModel": {
          "type": "string",
          "default": "defaultModel"
        },
        "modelMap": {
          "type": "object",
          "description": "Mapping of request paths to model names.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "schema": {
      "type": "object",
      "description": "Function to determine the schema to use for a request. Returns the schema name based on the request path.",
      "properties": {
        "defaultSchema": {
          "type": "string",
          "default": "defaultSchema"
        },
        "schemaMap": {
          "type": "object",
          "description": "Mapping of request paths to schema names.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "multiTenant": {
      "type": "object",
      "description": "Function to determine if multi-tenant mode is enabled. Returns true if the request contains a tenant ID in the specified header.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "headerKey": {
          "type": "string",
          "default": "x-tenant-id"
        },
        "tenants": {
          "type": "object",
          "description": "Mapping of tenant IDs to their MongoDB URIs.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "initOptions": {
          "type": "object",
          "properties": {
            "lazy": {
              "type": "boolean",
              "default": false,
              "description": "If true, AbimongoClient will not connect to MongoDB until the first request."
            },
            "config": {},
            "retryAttempts": {
              "type": "integer",
              "default": 3,
              "description": "Number of retry attempts for MongoDB connection."
            }
          }
        }
      }
    },
    "logger": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error",
            "fatal",
            "trace"
          ]
        },
        "colorize": {
          "type": "boolean"
        },
        "json": {
          "type": "boolean"
        },
        "transports": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "console",
                  "file",
                  "http"
                ]
              },
              "options": {
                "type": "object"
              }
            }
          }
        },
        "excludedSources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "circuitBreaker": {
          "enabled": true,
          "retryAttempts": 5
        }
      }
    },
    "graphql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "subscriptions": {
          "type": "boolean",
          "default": false
        },
        "playground": {
          "type": "boolean",
          "default": true
        },
        "schemaOutputPath": {
          "type": "string",
          "default": "./src/graphql/schema.gql"
        }
      }
    },
    "features": {
      "type": "object",
      "properties": {
        "models": {
          "type": "string",
          "default": "./src/models"
        },
        "schemas": {
          "type": "string",
          "default": "./src/schemas"
        },
        "useRedisCache": {
          "type": "boolean",
          "default": false
        },
        "redisUri": {
          "type": "string",
          "default": ""
        }
      }
    },
    "advanced": {
      "type": "object",
      "description": "Advanced configuration options for Abimongo.",
      "properties": {
        "circuitBreaker": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "If true, enables the circuit breaker pattern to prevent cascading failures."
            },
            "retryAttempts": {
              "type": "integer",
              "default": 5,
              "description": "Number of retry attempts before the circuit breaker opens."
            }
          }
        },
        "garbageCollector": {
          "type": "object",
          "description": "Configuration for the garbage collector that cleans up old data.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "retentionPeriod": {
              "type": "integer",
              "default": 30,
              "description": "Number of days to retain garbage collected data."
            },
            "logResults": {
              "type": "boolean",
              "default": true,
              "description": "If true, logs the results of garbage collection."
            }
          }
        },
        "gcCron": {
          "type": "string",
          "default": "*/10 * * * * *"
        }
      }
    },
    "abimongoCoreVersion": {
      "type": "string",
      "default": "1.0.0",
      "description": "Version of the Abimongo Core library."
    }
  },
  "required": [
    "mongoUri"
  ]
}